{
  "name": "@whisperr/wizard",
  "version": "0.10.3",
  "description": "Whisperr Wizard \u2014 one command to integrate the Whisperr SDK into your app. Authenticates with your onboarded account and uses an AI coding agent to wire up identify() and your business events automatically.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhisperrAI/whisperr-wizard.git"
  },
  "homepage": "https://github.com/WhisperrAI/whisperr-wizard#readme",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "bin": {
    "whisperr": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build",
    "dev:local": "tsx src/index.ts",
    "eval:mock": "tsx evals/runner.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.168",
    "@clack/prompts": "^1.5.1",
    "open": "^11.0.0",
    "picocolors": "^1.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
